# TCP port the HTTP server listens on (all interfaces). Default: 3000
PORT=3000
# Standard Node meaning. Default: unset (the container image sets production)
# NODE_ENV=production
# Initial state of the Orca dashboard feature flag (GET /dashboard, /api/orca/*).
# on/true/1 (any case) enable it; anything else or unset disables it. Default: off
# Toggle at runtime from loopback: PUT /api/features/orca-dashboard {"enabled":true|false}
ORCA_DASHBOARD=off
# Orca CLI executable the dashboard runs (read-only `orca orchestration ... --json` commands).
# Default: orca (found on PATH)
ORCA_CLI=orca
